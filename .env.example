# YouTube Data API v3 key, for song search. Without it, people can still paste YouTube links.
# Get one: https://console.cloud.google.com → create project → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=

# Port to listen on (default 3000)
# PORT=3000

# Override the address phones are sent to (default: this computer's LAN IP)
# PUBLIC_URL=http://192.168.1.20:3000

# Set to 1 when running behind a reverse proxy such as nginx (production), so rate limits use each visitor's real address
# TRUST_PROXY=1
